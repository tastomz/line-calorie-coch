NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
# IANA timezone used for "today" FoodLog windows (default Asia/Bangkok)
APP_TIMEZONE=Asia/Bangkok
# Channel secret (Messaging API) — required for webhook signature verification
LINE_CHANNEL_SECRET=
# Long-lived channel access token — required to reply/push messages (not the channel secret)
LINE_CHANNEL_ACCESS_TOKEN=
# OpenAI API key — required for food photo/text nutrition estimation
OPENAI_API_KEY=
# Google Sheets reporting/export (optional — set ALL three or leave ALL empty)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; use \n for newlines when stored in a single-line env value
GOOGLE_PRIVATE_KEY=

# Production notes (do not put real secrets here):
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN / OPENAI_API_KEY required
# See docs/DEPLOYMENT.md, docs/DATABASE.md, docs/BACKUP.md
# Optional retention cleanup: LINE_EVENT_RETENTION_DAYS=30 npm run cleanup:retention
