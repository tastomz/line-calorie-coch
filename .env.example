NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
# IANA timezone used for "today" FoodLog windows (default Asia/Bangkok)
APP_TIMEZONE=Asia/Bangkok
# Channel secret (Messaging API) — required for webhook signature verification
LINE_CHANNEL_SECRET=
# Long-lived channel access token — required to reply/push messages (not the channel secret)
LINE_CHANNEL_ACCESS_TOKEN=
# OpenAI API key — required for food photo/text nutrition estimation
OPENAI_API_KEY=
# Google Sheets reporting/export (optional — set ALL three or leave ALL empty)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; use \n for newlines when stored in a single-line env value
GOOGLE_PRIVATE_KEY=

# --- Membership / payment (TEST only; PAYMENT LIVE = NOT ACTIVE) ---
# Public base URL of this app (or frontend) for membership pages
MEMBERSHIP_WEB_URL=http://localhost:3000
MEMBERSHIP_SESSION_SECRET=change-me-membership-session
PRO_MONTHLY_PRICE_THB=50
TRIAL_DEFAULT_DAYS=7

# Stripe TEST mode only (sk_test_… / whsec_… / price_…). Never commit real values.
# Live keys (sk_live_) are rejected by validation.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# LINE Login / LIFF (optional — for web identity; signed LINE link also works)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Admin dashboard (/admin) — use ADMIN_PASSWORD_HASH in production
ADMIN_SESSION_SECRET=change-me-admin-session
ADMIN_USERNAME=
# Dev only plaintext (ignored in production if hash missing → login blocked):
ADMIN_PASSWORD=
# sha256 hex of `${password}:${ADMIN_SESSION_SECRET}`
ADMIN_PASSWORD_HASH=
# Comma-separated LINE user ids that receive User.role=ADMIN on create/login (bootstrap; no public promote API)
ADMIN_BOOTSTRAP_LINE_USER_IDS=local-admin-user

# Payment mode: MOCK (default local) | STRIPE (TEST keys required)
PAYMENT_MODE=MOCK

# Explicit opt-in for web checkout buttons / POST /api/membership/checkout.
# Leave unset/false so users cannot accidentally start payment. Stripe code stays intact.
ENABLE_MEMBERSHIP_CHECKOUT=false

# Local membership QA tools (/dev/*) — MUST stay false/unset in production
ENABLE_DEV_MEMBERSHIP_TOOLS=true

# Production notes (do not put real secrets here):
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN / OPENAI_API_KEY required
# See docs/DEPLOYMENT.md, docs/DATABASE.md, docs/BACKUP.md, docs/MEMBERSHIP.md
# Optional retention cleanup: LINE_EVENT_RETENTION_DAYS=30 npm run cleanup:retention
